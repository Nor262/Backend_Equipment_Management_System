# Kết nối CSDL cục bộ (Local Development)
DATABASE_URL="mysql://btl_user:btl_password@localhost:3306/btl_db"

# Kết nối CSDL đám mây Aiven MySQL (Production/Staging - Yêu cầu tệp prisma/ca.pem)
# DATABASE_URL="mysql://avnadmin:<MẬT_KHẨU>@<HOST_AIVEN>:<PORT_AIVEN>/defaultdb?sslcert=ca.pem"
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
JWT_SECRET="super-secret-key"
REDIS_HOST="localhost"
REDIS_PORT=6379

# Firebase Cloud Messaging (Push Notifications)
# Cách 1: Đặt đường dẫn tuyệt đối tới file JSON Service Account
FIREBASE_SERVICE_ACCOUNT_PATH="/absolute/path/to/firebase-service-account.json"
# Cách 2 (CI/CD): Dán nội dung JSON inline (bỏ dấu xuống dòng)
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"..."}'

# SMTP Email Configuration (Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""